# Copy to .env (gitignored) and fill in. `make run` passes it via --env-file.
# Values here are placeholders, not real credentials.
BITBUCKET_URL=https://bitbucket.example.com
# bearer (HTTP access token as Bearer) or basic (username + password/token)
BITBUCKET_AUTH=bearer
BITBUCKET_USER=your-username
BITBUCKET_PAT=REPLACE_WITH_YOUR_HTTP_ACCESS_TOKEN
# BITBUCKET_PASSWORD=only-if-you-use-basic-with-a-password
# BITBUCKET_CA_BUNDLE=~/certs/internal-ca.pem
